# Required ---------------------------------------------------------------
# MongoDB Atlas: Database > Connect > Drivers. Replace <password> and add a database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/paisabachao
# If you get "queryTxt ETIMEOUT", your network's DNS is blocking part of the lookup. Use the
# mongodb://host1,host2,host3 form instead. See "Good to know" in the README.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Public address of the app, used in email links.
APP_URL=http://localhost:3000

# Google sign-in (the button appears once both are set) -------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email for verification, password reset and invites ---------------------
# Without this, links are printed to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PaisaBachao <no-reply@example.com>

# Cloudinary for receipts and pictures -----------------------------------
# Without this, files are saved in .uploads on the server's disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI ------------------------------------------------------------
# Scanning and the assistant work for free without this. With a key from
# aistudio.google.com, scans are more accurate and the assistant handles free-form questions.
GEMINI_API_KEY=
# Any Gemini models your key can use. The backup is tried if the main model is busy.
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODEL=gemini-flash-lite-latest
# AI calls allowed per user per day, per feature. Past this, the free versions take over.
AI_DAILY_LIMIT=30
